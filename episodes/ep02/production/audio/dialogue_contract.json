    {
      "id": "E2_D02",
      "block": "N01",
      "speaker_id": "C03",
      "text": "臣……",
      "source_start": 5,
      "source_end": 5.8,
      "start": 5,
      "end": 5.8,
      "delivery": "短促起音后停住，不重复多遍。",
      "voice_reference_file": "assets/audio/voice_references/03_xiaotui.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D03",
      "block": "N01",
      "speaker_id": "C01",
      "text": "有什么不能说？直说。",
      "source_start": 8.2,
      "source_end": 10.8,
      "start": 8.2,
      "end": 10.8,
      "delivery": "威严中允许直言。",
      "voice_reference_file": "assets/audio/voice_references/01_sun_yalong.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D04",
      "block": "N01",
      "speaker_id": "C03",
      "text": "密探来报，徽州官仓闭赈，米价又涨了三成。",
      "source_start": 11.5,
      "source_end": 17.7,
      "start": 11.5,
      "end": 17.7,
      "delivery": "报告事实，停顿自然。",
      "voice_reference_file": "assets/audio/voice_references/03_xiaotui.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D05",
      "block": "N01",
      "speaker_id": "C03",
      "text": "百姓暗地里怨陛下，说新皇登基，也不给人活路。",
      "source_start": 18.4,
      "source_end": 24.5,
      "start": 18.4,
      "end": 24.5,
      "delivery": "犯颜话略迟疑，但不压掉字。",
      "voice_reference_file": "assets/audio/voice_references/03_xiaotui.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D06",
      "block": "N02",
      "speaker_id": "C01",
      "text": "派都察院御史，作钦差去查，如何？",
      "source_start": 0.5,
      "source_end": 4.7,
      "start": 30.5,
      "end": 34.7,
      "delivery": "求解，语速平稳。",
      "voice_reference_file": "assets/audio/voice_references/01_sun_yalong.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D07",
      "block": "N02",
      "speaker_id": "C02",
      "text": "钦差未到，街已扫净，仓也填满了。",
      "source_start": 5.4,
      "source_end": 9.8,
      "start": 35.4,
      "end": 39.8,
      "delivery": "平静精准，绝不喜剧腔。",
      "voice_reference_file": "assets/audio/voice_references/04_xika.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D08",
      "block": "N02",
      "speaker_id": "C02",
      "text": "灾民往城外一赶，陛下看见的，还是太平。",
      "source_start": 10.2,
      "source_end": 15.6,
      "start": 40.2,
      "end": 45.6,
      "delivery": "同场西卡自然画外声；帝只听。",
      "voice_reference_file": "assets/audio/voice_references/04_xika.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": false,
      "mouth_rule": "画外说话者出声；画面中的听者闭嘴，不能代说。"
    },
    {
      "id": "E2_D09",
      "block": "N02",
      "speaker_id": "C01",
      "text": "那依你呢？",
      "source_start": 16.5,
      "source_end": 18.2,
      "start": 46.5,
      "end": 48.2,
      "delivery": "略向前，愿听劝。",
      "voice_reference_file": "assets/audio/voice_references/01_sun_yalong.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D10",
      "block": "N02",
      "speaker_id": "C02",
      "text": "陛下微服走一趟，方知真假。",
      "source_start": 19.4,
      "source_end": 23.2,
      "start": 49.4,
      "end": 53.2,
      "delivery": "压低一点，提秘密行动。",
      "voice_reference_file": "assets/audio/voice_references/04_xika.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D11",
      "block": "N02",
      "speaker_id": "C01",
      "text": "好。你留京坐镇，朕只带小腿。",
      "source_start": 24.3,
      "source_end": 28.5,
      "start": 54.3,
      "end": 58.5,
      "delivery": "决定果断，尾字说完再转身。",
      "voice_reference_file": "assets/audio/voice_references/01_sun_yalong.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D12",
      "block": "N03",
      "speaker_id": "C01",
      "text": "老人家，官仓为何不开？",
      "source_start": 4.4,
      "source_end": 7.1,
      "start": 64.4,
      "end": 67.1,
      "delivery": "克制直问，有外乡口音感但不夸张方言。",
      "voice_reference_file": "assets/audio/voice_references/01_sun_yalong.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D13",
      "block": "N03",
      "speaker_id": "E09",
      "text": "客官，莫问了。",
      "source_start": 8.1,
      "source_end": 9.7,
      "start": 68.1,
      "end": 69.7,
      "delivery": "原创老年男声，低声警惕。",
      "voice_reference_file": null,
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D14",
      "block": "N03",
      "speaker_id": "E10",
      "text": "快些！潘姑娘今夜登台！",
      "source_start": 14.4,
      "source_end": 17.3,
      "start": 74.4,
      "end": 77.3,
      "delivery": "原创成年男声，向同伴招呼。",
      "voice_reference_file": null,
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D15",
      "block": "N03",
      "speaker_id": "C01",
      "text": "哪位潘姑娘？",
      "source_start": 18.5,
      "source_end": 20.4,
      "start": 78.5,
      "end": 80.4,
      "delivery": "好奇而自然。",
      "voice_reference_file": "assets/audio/voice_references/01_sun_yalong.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D16",
      "block": "N03",
      "speaker_id": "E10",
      "text": "潘慧姑娘。听松楼的才女，半城的文人都认得她。",
      "source_start": 22.2,
      "source_end": 27.9,
      "start": 82.2,
      "end": 87.9,
      "delivery": "同一个茶客同一原创声，介绍清楚不加词。",
      "voice_reference_file": null,
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D17",
      "block": "N05",
      "speaker_id": "C03",
      "text": "公子，潘姑娘交游广，或许知道粮灾的内情。不妨问问她。",
      "source_start": 0.5,
      "source_end": 6.7,
      "start": 120.5,
      "end": 126.7,
      "delivery": "贴近耳边低语，叫公子不能叫陛下。",
      "voice_reference_file": "assets/audio/voice_references/03_xiaotui.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D18",
      "block": "N05",
      "speaker_id": "C05",
      "text": "今夜以诗会友。",
      "source_start": 8.1,
      "source_end": 10.3,
      "start": 128.1,
      "end": 130.3,
      "delivery": "舞后气息略缓，声音温柔清楚。",
      "voice_reference_file": "assets/audio/voice_references/02_pan_hui.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D19",
      "block": "N05",
      "speaker_id": "C05",
      "text": "我出半句，诸位来续。谁续得好，便请入内叙谈。",
      "source_start": 11.2,
      "source_end": 17.7,
      "start": 131.2,
      "end": 137.7,
      "delivery": "两句间自然停顿，有主见的邀请。",
      "voice_reference_file": "assets/audio/voice_references/02_pan_hui.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D20",
      "block": "N05",
      "speaker_id": "E11",
      "text": "好！",
      "source_start": 19.1,
      "source_end": 19.9,
      "start": 139.1,
      "end": 139.9,
      "delivery": "一名原创成年客人欢呼，其余人不跟喊完整台词。",
      "voice_reference_file": null,
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    },
    {
      "id": "E2_D21",
      "block": "N05",
      "speaker_id": "C01",
      "text": "好，我也试试。",
      "source_start": 24,
      "source_end": 26.2,
      "start": 144,
      "end": 146.2,
      "delivery": "低声对小腿，认真而含笑。",
      "voice_reference_file": "assets/audio/voice_references/01_sun_yalong.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "visible_speaker": true,
      "mouth_rule": "可见说话者逐字同步口型；其余可见人物闭嘴自然反应。"
    }
