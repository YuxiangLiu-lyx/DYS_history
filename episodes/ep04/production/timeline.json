    {
      "speaker_id": "C05",
      "text": "他不一样。",
      "source_start": 24,
      "source_end": 25.8,
      "delivery": "轻而笃定，随后闭口。",
      "visible_speaker": true,
      "id": "E4_D13",
      "block": "Q03",
      "start": 84,
      "end": 85.8,
      "voice_reference_file": "assets/audio/voice_references/02_pan_hui.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "mouth_rule": "可见发言者逐字同步嘴型，其他人闭口；画外发声不驱动听者嘴。"
    },
    {
      "speaker_id": "C01",
      "text": "魏笑太狡猾。查仓，他能换粮；问人，谁敢开口？",
      "source_start": 0.5,
      "source_end": 5.7,
      "delivery": "快速但不吞字，查证受阻的分析。",
      "visible_speaker": true,
