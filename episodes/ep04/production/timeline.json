  "dialogues": [
    {
      "speaker_id": "C05",
      "text": "公子叫我音音便是。",
      "source_start": 0.7,
      "source_end": 3.7,
      "delivery": "温柔坦然，音音是私称，不改人物ID。",
      "visible_speaker": true,
      "id": "E4_D01",
      "block": "Q01",
      "start": 0.7,
      "end": 3.7,
      "voice_reference_file": "assets/audio/voice_references/02_pan_hui.mp3",
