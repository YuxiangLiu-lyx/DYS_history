      "mouth_rule": "可见发言者逐字同步嘴型，其他人闭口；画外发声不驱动听者嘴。"
    },
    {
      "speaker_id": "C01",
      "text": "魏笑太狡猾。查仓，他能换粮；问人，谁敢开口？",
      "source_start": 0.5,
      "source_end": 5.7,
      "delivery": "快速但不吞字，查证受阻的分析。",
      "visible_speaker": true,
      "id": "E5_D01",
      "block": "Q04",
      "start": 90.5,
      "end": 95.7,
      "voice_reference_file": "assets/audio/voice_references/01_sun_yalong.mp3",
      "voice_reference_is_final_dialogue": false,
