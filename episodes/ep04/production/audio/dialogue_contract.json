      "mouth_rule": "可见发言者逐字同步嘴型，其他人闭口；画外发声不驱动听者嘴。"
    },
    {
      "speaker_id": "C03",
      "text": "公子何不再问潘姑娘？听说她常在迎客松下独立，谁来都不理。",
      "source_start": 6.3,
      "source_end": 14.1,
      "delivery": "沿用微服称公子，内室也不必故意暴露称呼。",
      "visible_speaker": true,
      "id": "E5_D02",
      "block": "Q04",
      "start": 96.3,
      "end": 104.1,
      "voice_reference_file": "assets/audio/voice_references/03_xiaotui.mp3",
      "voice_reference_is_final_dialogue": false,
      "audible_source": "native_generated_dialogue",
      "mouth_rule": "可见发言者逐字同步嘴型，其他人闭口；画外发声不驱动听者嘴。"
    },
    {
      "speaker_id": "C03",
      "text": "她最爱《卜卦》。公子若以此曲作引，或许肯再开口。",
      "source_start": 15,
      "source_end": 21.6,
      "delivery": "歌名自然说出，语速平稳。",
      "visible_speaker": true,
      "id": "E5_D03",
      "block": "Q04",
      "start": 105,
      "end": 111.6,
      "voice_reference_file": "assets/audio/voice_references/03_xiaotui.mp3",
